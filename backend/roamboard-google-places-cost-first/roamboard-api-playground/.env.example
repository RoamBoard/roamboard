# Primary POI provider. Keep this key server-side.
GOOGLE_PLACES_API_KEY=

# Map display/reverse geocoding. A public pk.* token is sufficient for these tests.
MAPBOX_ACCESS_TOKEN=

# Pick either Pexels or Unsplash first. You do not need both.
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=

# GeoNames uses your account username rather than a random API key.
GEONAMES_USERNAME=

# User-photo storage. Keep API_SECRET server-side.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
