{
    "name": "roamboard-backend",
    "version": "0.1.0",
    "description": "Roamboard API",
    "private": true,
    "type": "module",
    "main": "dist/server.js",
    "engines": {
        "node": "24.x"
    },
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit",
        "test": "tsx --test",
        "test:db": "tsx --test integration/boards.db.ts",
        "build": "tsc -p tsconfig.build.json",
        "cleanup:images": "tsx src/jobs/cleanup-unused-images.ts",
        "start": "node dist/server.js",
        "check": "npm run lint && npm run typecheck && npm test && npm run build"
    },
    "keywords": [],
    "author": "",
    "license": "UNLICENSED",
    "dependencies": {
        "cloudinary": "^2.11.0",
        "cors": "^2.8.6",
        "debug": "^4.4.3",
        "dotenv": "^18.0.5",
        "express": "^5.2.1",
        "google-auth-library": "^11.3.0",
        "helmet": "^8.3.0",
        "pg": "^8.23.1",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/cors": "^2.8.19",
        "@types/debug": "^4.1.13",
        "@types/express": "^5.0.6",
        "@types/node": "^24.19.0",
        "@types/pg": "^8.23.1",
        "@types/supertest": "^7.2.1",
        "eslint": "^10.11.0",
        "supertest": "^7.3.0",
        "tsx": "^4.23.15",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.0"
    }
}
