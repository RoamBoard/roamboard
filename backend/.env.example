PORT=3001
CLIENT_ORIGIN=http://localhost:3000
PUBLIC_DOMAIN=localhost
STORAGE=postgres
DATABASE_URL=postgresql://roamboard_user:your_password@127.0.0.1:15432/roamboard_dev
# Optional override used by backend container inside Docker Compose (defaults to DATABASE_URL):
# DOCKER_DATABASE_URL=postgresql://roamboard_user:your_password@postgres:5432/roamboard_dev
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
POSTGRES_ADMIN_PASSWORD=replace-with-a-long-random-admin-password
ROAMBOARD_DB_PASSWORD=replace-with-a-different-long-random-app-password
# For the shared Azure DB, open the SSH tunnel described in deploy/README.md,
# then use 127.0.0.1:15432 in DATABASE_URL with the shared application password.
# Docker database settings: required on the Azure VM, not for local npm run dev.
# Use raw passwords here; URL-encode the app password only inside DATABASE_URL.
# Required for login: same value as frontend NEXT_PUBLIC_GOOGLE_CLIENT_ID.

# Cloudinary credentials for user uploaded images and board thumbnails.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Mapbox requires a billing-enabled Mapbox project for more API requests.
MAPBOX_ACCESS_TOKEN=
MAPBOX_PUBLIC_TOKEN=

UNSPLASH_ACCESS_KEY=

# Google Places requires a billing-enabled Google project.
GOOGLE_PLACES_API_KEY=

# Saved Board locations; free Geoapify key, no permanent Mapbox fallback
GEOAPIFY_API_KEY=

# npm run dev selects development. Use production for deployed npm start.
NODE_ENV=production
