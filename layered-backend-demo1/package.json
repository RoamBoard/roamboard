{
  "name": "layered-backend-demo1",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A feature-first, layered Express backend demo.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "test": "tsx --test test/todos.api.test.ts test/search.query.test.ts test/destination.schemas.test.ts test/provider.cloudinary.test.ts",
    "test:integration": "tsx --test test/search.integration.test.ts test/postgres.integration.test.ts",
    "search:setup": "tsx src/features/search/search.cli.ts setup",
    "search:seed": "tsx src/features/search/search.cli.ts seed",
    "search:reindex": "tsx src/features/search/search.cli.ts reindex",
    "search:reindex:container": "node dist/src/features/search/search.cli.js reindex",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@elastic/elasticsearch": "8.18.2",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "debug": "^4.4.3",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "pino-http": "^11.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/debug": "^4.1.13",
    "@types/express": "^5.0.5",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.3.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
