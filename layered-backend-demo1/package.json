{
    "name": "layered-backend-demo1",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "description": "A feature-first, layered Express backend demo.",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc",
        "start": "node dist/src/server.js",
        "test": "tsx --test test/todos.api.test.ts",
        "typecheck": "tsc --noEmit",
        "check": "npm run typecheck && npm test"
    },
    "engines": {
        "node": ">=18"
    },
    "dependencies": {
        "cors": "^2.8.6",
        "dotenv": "^18.0.4",
        "express": "^5.2.1",
        "helmet": "^8.3.0",
        "pino-http": "^11.0.0",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.5",
        "@types/node": "^24.10.1",
        "@types/supertest": "^6.0.3",
        "supertest": "^7.3.0",
        "tsx": "^4.20.6",
        "typescript": "^5.9.3"
    }
}
