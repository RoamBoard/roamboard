NODE_ENV=development
PORT=3000
CLIENT_ORIGIN=http://localhost:5173
STORAGE=memory

# For the host API with Docker's PostgreSQL service, set STORAGE=postgres.
# DATABASE_URL=postgres://roamboard:change_me_for_local_demo@localhost:5433/roamboard

# Docker Compose reads this value when starting PostgreSQL and the API.
POSTGRES_PASSWORD=change_me_for_local_demo



# Required only when NODE_ENV=production to authorize the reindex endpoint.
# SEARCH_REINDEX_KEY=

# Optional provider credentials. Destination search is unavailable without Mapbox;
# weather and Wikipedia work without credentials. These keys are used only by the
# developer provider lab or optional destination enrichment. Keep them server-side.
# MAPBOX_ACCESS_TOKEN=
# Recommended after adding a card: use a separate pk. token for browser maps,
# limited to map scopes and restricted to your frontend URLs.
# MAPBOX_PUBLIC_TOKEN=
# UNSPLASH_ACCESS_KEY=
# GOOGLE_PLACES_API_KEY= # Google Places requires a billing-enabled Google project.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Saved Board locations; free Geoapify key, no permanent Mapbox fallback
GEOAPIFY_API_KEY=